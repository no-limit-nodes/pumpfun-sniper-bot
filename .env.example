# NoLimitNodes API key for the decoded event stream: https://app.nolimitnodes.com/register
NLN_API_KEY=sk_live_your_key
# NLN_STREAM_ENDPOINT=stream-1.nln.clr3.org:443

# Live trading only (python run_sniper.py --live)
NLN_RPC_URL=https://your-nln-rpc-endpoint
# Use a dedicated hot wallet. Set one of these:
SOLANA_KEYPAIR_PATH=
SOLANA_PRIVATE_KEY=
# Optional: Jupiter API key for higher rate limits (https://developers.jup.ag/portal)
JUPITER_API_KEY=

# Strategy
MODE=momentum
BUY_SOL=0.05
MAX_POSITIONS=3
TAKE_PROFIT_PCT=100
STOP_LOSS_PCT=30
TRAILING_STOP_PCT=0
MAX_HOLD_S=300
MOMENTUM_BUYERS=10
MOMENTUM_WINDOW_S=30
MAX_ENTRY_MCAP_SOL=60
MAX_DEV_BUY_SOL=0
KEYWORDS=
EXCLUDE_KEYWORDS=
BLOCKED_CREATORS=
MAX_DAILY_LOSS_SOL=0.5
SLIPPAGE_BPS=1500
PRIORITY=high
PAPER_COST_BPS=200

# Telegram alerts (python run_sniper.py --telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
